{
  "manifest_version": 3,
  "name": "LeetRecall",
  "version": "0.2.3",
  "description": "Hands-free spaced repetition for LeetCode problems.",
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["storage","notifications", "alarms"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon48.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["review-url.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
